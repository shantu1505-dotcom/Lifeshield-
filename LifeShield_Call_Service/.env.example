# LifeShield Node.js Call Service - environment example
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env to GitHub.

PORT=4000

# Same Twilio account already used by the Flask app (app.py / .env)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# A shared secret so only your Flask app can trigger calls on this service.
# Put the same value in Flask's .env as CALL_SERVICE_SECRET.
CALL_SERVICE_SECRET=change-this-to-a-random-string
